{
    "name": "lucid-php/lucid-php",
    "description": "Lucid-PHP - Clear PHP, No Magic. A strict, explicit PHP framework.",
    "type": "project",
    "license": "MIT",
    "authors": [
        {
            "name": "Magnus Strömberg",
            "email": "magnus@magnus.tech"
        }
    ],
    "require": {
        "php": "^8.5"
    },
    "autoload": {
        "psr-4": {
            "Core\\": "src/Core/",
            "App\\": "src/App/",
            "Database\\Seeds\\": "database/seeds/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable",
    "require-dev": {
        "phpunit/phpunit": "^12.5",
        "phpstan/phpstan": "^2.1",
        "friendsofphp/php-cs-fixer": "^3.65"
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse --memory-limit=1G",
        "cs": "php-cs-fixer fix --dry-run --diff",
        "cs-fix": "php-cs-fixer fix"
    }
}
